# =====================================================================
# CAMPUSCONNECT BACKEND CONFIGURATION (PRODUCTION TEMPLATE)
# =====================================================================

# Flask & JWT Security Secrets (Use strong random strings in production)
SECRET_KEY=change_this_to_a_random_secure_secret_in_production
JWT_SECRET_KEY=change_this_to_a_random_jwt_secret_in_production
PORT=5000
FLASK_ENV=production

# Database Configuration (PostgreSQL for production, falls back to SQLite locally if unset)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/campusconnect

# CORS Origins (Comma-separated list of allowed frontend domains)
# CORS_ORIGINS=http://localhost:5173,https://your-production-app.vercel.app

# Optional: Email Configurations for Password Reset Emails
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-college-portal@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_USE_TLS=True
# MAIL_DEFAULT_SENDER=your-college-portal@gmail.com
